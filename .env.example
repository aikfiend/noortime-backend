# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development

# MySQL connection string
DATABASE_URL=mysql://user:password@localhost:3306/noortime

# Google OAuth credentials (console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Random 32+ char secret for signing sessions
SESSION_SECRET=change-me-to-a-long-random-string

# URL of the deployed frontend (used for CORS and OAuth callback redirect)
FRONTEND_URL=http://localhost:5173

# Backend public URL (used for the OAuth callback URL)
BACKEND_URL=http://localhost:3001

# Restrict sign-in to a single email domain (without the @)
ALLOWED_EMAIL_DOMAIN=clips4sale.com

# Port the backend listens on
PORT=3001
